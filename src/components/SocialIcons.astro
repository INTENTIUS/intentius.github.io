---
// The header's right side: a Contact link first, since every offer on the
// site ends in getting in touch, then Starlight's own social icons.
import Default from '@astrojs/starlight/components/SocialIcons.astro';
---
<a class="in-contact" href="/contact/">Contact</a>
<Default />

<style>
	.in-contact {
		margin-right: 0.5rem;
		padding: 0.3rem 0.8rem;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-white);
		text-decoration: none;
		border: 1px solid var(--in-rule);
		border-radius: 999px;
	}
	.in-contact:hover {
		border-color: var(--in-gold);
	}
</style>
