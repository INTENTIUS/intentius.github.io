---
// The header's right side: the Demo and Contact links first, since every
// offer on the site ends in trying it or getting in touch, then Starlight's
// own social icons.
import Default from '@astrojs/starlight/components/SocialIcons.astro';
---
<a class="in-contact" href="https://demo.intentius.io/">Demo</a>
<a class="in-contact" href="/contact/">Contact</a>
<Default />

<style>
	.in-contact {
		margin-right: 0.5rem;
		padding: 0.3rem 0.8rem;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-white);
		text-decoration: none;
		border: 1px solid var(--in-rule);
		border-radius: 999px;
	}
	.in-contact:hover {
		border-color: var(--in-gold);
	}
	@media (max-width: 30rem) {
		.in-contact { margin-right: 0.25rem; padding: 0.2rem 0.55rem; font-size: 0.78rem; }
		.in-contact[href^='https://demo'] { display: none; }
	}
</style>
