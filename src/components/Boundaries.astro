---
// Two models of an estate boundary, side by side, each with its backend and
// two applies to one estate. Left: the state file's application lock is the
// boundary, so apply 2 waits for apply 1 even on another resource. Right:
// each resource carries its estate's label and has its own record with its
// own lock, so apply 1 on vpc and apply 2 on sg run together. No product
// names; the page around it names them.

const COLS = [26, 142, 280, 392];
const ROWS = [178, 234];
const PW = 96, PH = 32;
const RES = [
	{ n: 'vpc', c: 0, r: 0, e: 'net' }, { n: 'subnet', c: 1, r: 0, e: 'net' },
	{ n: 'queue', c: 2, r: 0, e: 'pay' }, { n: 'function', c: 3, r: 0, e: 'pay' },
	{ n: 'sg', c: 0, r: 1, e: 'net' }, { n: 'bucket', c: 1, r: 1, e: 'logs' },
	{ n: 'bucket', c: 2, r: 1, e: 'logs' }, { n: 'dns', c: 3, r: 1, e: 'pay' },
];
const ACCOUNTS = [{ x: 12, name: 'ACCOUNT A' }, { x: 262, name: 'ACCOUNT B' }];
const FILES = [200, 385];
// Records in the store, laid out like the resources: two rows of four.
const RX = (c) => 160 + c * 89, RY = (r) => 20 + r * 34, RW = 80, RH = 28;
// A padlock centred on (x, y): shackle above, body below, keyhole.
const pad = (x, y, s = 1) => ({
	shackle: `M${x - 4.2 * s} ${y - 1 * s} V${y - 4.5 * s} a${4.2 * s} ${4.2 * s} 0 0 1 ${8.4 * s} 0 V${y - 1 * s}`,
	body: { x: x - 7 * s, y: y - 1.5 * s, w: 14 * s, h: 11 * s, rx: 2.2 * s },
	hole: { cx: x, cy: y + 3.6 * s, r: 1.5 * s },
	sw: 2.4 * s,
});
const held = new Set(['vpc', 'sg']);
---
<figure class="bd not-content" aria-labelledby="bd-cap">
	<div class="bd-panels">
		<div class="bd-panel">
			<p class="bd-h">Estate boundaries as application locks</p>
			<svg viewBox="0 0 520 300" role="img" aria-label="Estate boundaries as application locks: each estate is one state file behind the tool's own lock. Apply 1 on vpc holds the lock, so apply 2 on sg waits, though it touches another resource.">
				<g class="bd-run"><rect x="6" y="20" width="130" height="26" rx="13" /><text x="18" y="37.5">apply 1 · vpc</text><text class="bd-st" x="126" y="37.5" text-anchor="end">runs</text></g>
				<g class="bd-wait"><rect x="6" y="54" width="130" height="26" rx="13" /><text x="18" y="71.5">apply 2 · sg</text><text class="bd-st" x="126" y="71.5" text-anchor="end">waits</text></g>
				<line class="bd-go" x1="136" y1="33" x2="172" y2="40" />
				<line class="bd-stop" x1="136" y1="67" x2="160" y2="62" />
				{FILES.map((cx, i) => {
					const p = pad(cx + 22, 22, 1.25);
					return (
						<g>
							<path class="bd-doc" d={`M${cx - 22} 18 H${cx + 10} L${cx + 22} 30 V80 H${cx - 22} Z`} />
							<path class="bd-fold" d={`M${cx + 10} 18 V30 H${cx + 22}`} />
							<line class="bd-docline" x1={cx - 13} y1="44" x2={cx + 13} y2="44" />
							<line class="bd-docline" x1={cx - 13} y1="54" x2={cx + 13} y2="54" />
							<line class="bd-docline" x1={cx - 13} y1="64" x2={cx + 5} y2="64" />
							<circle class="bd-padbg" cx={cx + 22} cy="24" r="14" />
							<path class={`bd-shackle${i === 0 ? ' bd-held' : ''}`} d={p.shackle} stroke-width={p.sw} />
							<rect class={`bd-body${i === 0 ? ' bd-held' : ''}`} x={p.body.x} y={p.body.y} width={p.body.w} height={p.body.h} rx={p.body.rx} />
							<circle class="bd-keyhole" cx={p.hole.cx} cy={p.hole.cy} r={p.hole.r} />
							<line class="bd-tie" x1={cx} y1="80" x2={cx} y2="160" />
						</g>
					);
				})}
				<text class="bd-lbl-sm" x="244" y="28">application lock</text>
				<rect class="bd-cloud" x="4" y="100" width="512" height="196" rx="14" />
				{ACCOUNTS.map((a) => (
					<g>
						<rect class="bd-acct" x={a.x} y="110" width="246" height="178" rx="10" />
						<text class="bd-cap" x={a.x + 12} y="128">{a.name}</text>
					</g>
				))}
				<rect class="bd-wall" x="18" y="160" width="234" height="118" rx="10" />
				<rect class="bd-wall" x="268" y="160" width="234" height="118" rx="10" />
				{RES.map((r) => (
					<g>
						<rect class={`bd-res${r.n === 'vpc' ? ' bd-res-on' : ''}`} x={COLS[r.c]} y={ROWS[r.r]} width={PW} height={PH} rx="7" />
						<text class="bd-rt" x={COLS[r.c] + PW / 2} y={ROWS[r.r] + 20.5} text-anchor="middle">{r.n}</text>
					</g>
				))}
			</svg>
			<p class="bd-note">An estate is one state file behind the tool's own lock. Apply 2 waits for apply 1, though they touch different resources.</p>
		</div>
		<div class="bd-divider" aria-hidden="true"></div>
		<div class="bd-panel">
			<p class="bd-h">Estate boundaries as resource labels</p>
			<svg viewBox="0 0 520 300" role="img" aria-label="Estate boundaries as resource labels: object storage keeps one record per resource, each with its own lock. Apply 1 locks the vpc record and apply 2 locks the sg record, so both run in the same estate. Resources sharing a label form an estate, one of them across both accounts.">
				<g class="bd-run"><rect x="6" y="20" width="130" height="26" rx="13" /><text x="18" y="37.5">apply 1 · vpc</text><text class="bd-st" x="126" y="37.5" text-anchor="end">runs</text></g>
				<g class="bd-run"><rect x="6" y="54" width="130" height="26" rx="13" /><text x="18" y="71.5">apply 2 · sg</text><text class="bd-st" x="126" y="71.5" text-anchor="end">runs</text></g>
				<rect class="bd-store" x="148" y="8" width="368" height="80" rx="12" />
				<line class="bd-go" x1="136" y1="33" x2={RX(0)} y2={RY(0) + RH / 2} />
				<line class="bd-go" x1="136" y1="67" x2={RX(0)} y2={RY(1) + RH / 2} />
				{RES.map((r) => {
					const x = RX(r.c), y = RY(r.r), on = held.has(r.n);
					const p = pad(x + RW - 11, y + 13, 0.8);
					return (
						<g>
							<rect class={`bd-rec${on ? ' bd-rec-on' : ''}`} x={x} y={y} width={RW} height={RH} rx="6" />
							<circle class={`bd-${r.e}-f`} cx={x + 11} cy={y + RH / 2} r="4" />
							<text class="bd-rect" x={x + 18} y={y + 18}>{r.n}</text>
							<path class={`bd-shackle${on ? ' bd-held' : ''}`} d={p.shackle} stroke-width={p.sw} />
							<rect class={`bd-body${on ? ' bd-held' : ''}`} x={p.body.x} y={p.body.y} width={p.body.w} height={p.body.h} rx={p.body.rx} />
							<circle class="bd-keyhole" cx={p.hole.cx} cy={p.hole.cy} r={p.hole.r} />
						</g>
					);
				})}
				<text class="bd-lbl-sm" x="156" y="99">object storage: one record and one lock per resource</text>
				<rect class="bd-cloud" x="4" y="104" width="512" height="192" rx="14" />
				{ACCOUNTS.map((a) => (
					<g>
						<rect class="bd-acct" x={a.x} y="112" width="246" height="176" rx="10" />
						<text class="bd-cap" x={a.x + 12} y="130">{a.name}</text>
					</g>
				))}
				<path class="bd-estate bd-net" d="M18 160 H248 V220 H132 V278 H18 Z" />
				<path class="bd-estate bd-pay" d="M272 160 H502 V278 H386 V220 H272 Z" />
				<rect class="bd-estate bd-logs" x="136" y="226" width="246" height="46" rx="10" />
				{RES.map((r) => (
					<g>
						<rect class={`bd-res${held.has(r.n) ? ' bd-res-on' : ''}`} x={COLS[r.c]} y={ROWS[r.r]} width={PW} height={PH} rx="7" />
						<text class="bd-rt" x={COLS[r.c] + PW / 2 - 6} y={ROWS[r.r] + 20.5} text-anchor="middle">{r.n}</text>
						<circle class={`bd-${r.e}-f`} cx={COLS[r.c] + PW - 12} cy={ROWS[r.r] + PH / 2} r="5" />
					</g>
				))}
				<g class="bd-chip bd-net-f"><rect x="26" y="150" width="76" height="20" rx="10" /><text x="64" y="164" text-anchor="middle">network</text></g>
				<g class="bd-chip bd-pay-f"><rect x="280" y="150" width="86" height="20" rx="10" /><text x="323" y="164" text-anchor="middle">payments</text></g>
				<g class="bd-chip bd-logs-f"><rect x="231" y="262" width="56" height="20" rx="10" /><text x="259" y="276" text-anchor="middle">logs</text></g>
			</svg>
			<p class="bd-note">Resources with the same label are one estate, in any account. Each resource has its own record and lock, so apply 1 and apply 2 run together.</p>
		</div>
	</div>
	<figcaption id="bd-cap">The same cloud and the same two applies under each model.</figcaption>
</figure>

<style>
	.bd {
		--net: #c9a96e; --logs: #b98be0; --pay: #4a9fd0;
		--go: #3fae8c; --wait: #e2a23b;
		margin: 2rem 0 2.5rem;
	}
	.bd-panels { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1.5rem; padding: 1.25rem 1.25rem 1.1rem; border-radius: 18px; border: 1px solid var(--sl-color-gray-5); background: var(--sl-color-black); }
	.bd-divider { width: 1px; background: linear-gradient(transparent, var(--sl-color-gray-5) 15%, var(--sl-color-gray-5) 85%, transparent); }
	.bd-h { margin: 0 0 0.75rem; font-family: var(--in-display, inherit); font-size: 1.3rem; font-weight: 700; color: var(--sl-color-white); }
	.bd svg { display: block; width: 100%; height: auto; }
	.bd-note { margin: 0.7rem 0 0; font-size: 0.95rem; line-height: 1.45; color: var(--sl-color-gray-2); }
	.bd figcaption { margin-top: 0.8rem; font-size: 0.85rem; color: var(--sl-color-gray-3); }

	.bd text { font-family: var(--sl-font, system-ui, sans-serif); }
	.bd-cap { font-size: 10px; letter-spacing: 0.08em; fill: var(--sl-color-gray-3); }
	.bd-rt { font-size: 12px; fill: var(--sl-color-gray-1); }
	.bd-rect { font-size: 10px; fill: var(--sl-color-gray-1); }
	.bd-lbl-sm { font-size: 11px; fill: var(--sl-color-gray-3); }

	/* applies */
	.bd-run rect { fill: color-mix(in srgb, var(--go) 16%, transparent); stroke: var(--go); stroke-width: 1.5; }
	.bd-wait rect { fill: color-mix(in srgb, var(--wait) 12%, transparent); stroke: var(--wait); stroke-width: 1.5; stroke-dasharray: 4 3; }
	.bd-run text, .bd-wait text { font-size: 12px; font-weight: 600; fill: var(--sl-color-white); }
	.bd-run .bd-st { fill: var(--go); font-weight: 700; }
	.bd-wait .bd-st { fill: var(--wait); font-weight: 700; }
	.bd-go { stroke: var(--go); stroke-width: 2; }
	.bd-stop { stroke: var(--wait); stroke-width: 2; stroke-dasharray: 3 3; }

	/* padlocks */
	.bd-padbg { fill: var(--sl-color-black); stroke: var(--sl-color-gray-5); }
	.bd-shackle { fill: none; stroke: var(--sl-color-gray-3); stroke-linecap: round; }
	.bd-body { fill: var(--sl-color-gray-3); }
	.bd-shackle.bd-held { stroke: var(--go); }
	.bd-body.bd-held { fill: var(--go); }
	.bd-keyhole { fill: var(--sl-color-black); }

	.bd-doc { fill: var(--sl-color-gray-6); stroke: var(--sl-color-gray-3); stroke-width: 2; stroke-linejoin: round; }
	.bd-fold { fill: none; stroke: var(--sl-color-gray-3); stroke-width: 2; stroke-linejoin: round; }
	.bd-docline { stroke: var(--sl-color-gray-4); stroke-width: 2; stroke-linecap: round; }
	.bd-tie { stroke: var(--sl-color-gray-3); stroke-width: 2; stroke-dasharray: 4 4; }

	.bd-cloud { fill: color-mix(in srgb, var(--sl-color-accent) 5%, transparent); stroke: var(--sl-color-gray-5); }
	.bd-acct { fill: none; stroke: var(--sl-color-gray-5); stroke-dasharray: 2 3; }
	.bd-wall { fill: color-mix(in srgb, var(--sl-color-gray-3) 10%, transparent); stroke: var(--sl-color-gray-3); stroke-width: 3; }
	.bd-res { fill: var(--sl-color-black); stroke: var(--sl-color-gray-5); }
	.bd-res-on { stroke: var(--go); stroke-width: 2; }
	.bd-store { fill: color-mix(in srgb, var(--sl-color-gray-3) 6%, transparent); stroke: var(--sl-color-gray-5); }
	.bd-rec { fill: var(--sl-color-gray-6); stroke: var(--sl-color-gray-5); }
	.bd-rec-on { stroke: var(--go); stroke-width: 2; }

	.bd-estate { stroke-width: 2.5; stroke-dasharray: 7 4; stroke-linejoin: round; }
	.bd-net { stroke: var(--net); fill: color-mix(in srgb, var(--net) 9%, transparent); }
	.bd-logs { stroke: var(--logs); fill: color-mix(in srgb, var(--logs) 11%, transparent); }
	.bd-pay { stroke: var(--pay); fill: color-mix(in srgb, var(--pay) 9%, transparent); }
	.bd-net-f { fill: var(--net); } .bd-logs-f { fill: var(--logs); } .bd-pay-f { fill: var(--pay); }
	.bd-chip text { font-size: 11px; font-weight: 700; fill: #14110b; }

	@media (max-width: 60rem) { .bd-panels { grid-template-columns: 1fr; } .bd-divider { width: auto; height: 1px; background: var(--sl-color-gray-5); } }
</style>
