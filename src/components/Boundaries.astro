---
// The zoomed-out picture: one cloud account, drawn twice. On the left each
// tool's file sews identity, values and writes together behind one lock, and
// the lock draws the boundary around its resources. On the right the
// resources carry their estate's label and draw the boundaries themselves;
// each resource has its own record, written with the store's own
// conditional write (a small lock per record). Same resources, same places,
// so the eye compares the boundaries.

// Resource grid shared by both panels.
const COLS = [30, 150, 270, 390];
const ROWS = [286, 346];
const PW = 100, PH = 32;
const RES = [
	{ n: 'vpc', c: 0, r: 0, e: 'net' }, { n: 'subnet', c: 1, r: 0, e: 'net' },
	{ n: 'bucket', c: 2, r: 0, e: 'pay' }, { n: 'queue', c: 3, r: 0, e: 'pay' },
	{ n: 'sg', c: 0, r: 1, e: 'net' }, { n: 'db', c: 1, r: 1, e: 'data' },
	{ n: 'function', c: 2, r: 1, e: 'pay' }, { n: 'dns', c: 3, r: 1, e: 'pay' },
];
const FILES = [
	{ x: 20, name: 'terraform.tfstate', cx: 138 },
	{ x: 280, name: 'Pulumi checkpoint', cx: 382 },
];
const STRIPES = [['Identity', 'id'], ['Values', 'val'], ['Writes', 'wr']];
const lock = (x, y, s = 1) => `M${x - 5 * s} ${y - 1 * s}h${10 * s}v${8 * s}h${-10 * s}z M${x - 3 * s} ${y - 1 * s}v${-3 * s}a${3 * s} ${3 * s} 0 0 1 ${6 * s} 0v${3 * s}`;
---
<figure class="bd not-content" aria-labelledby="bd-cap">
	<div class="bd-panels">
		<div class="bd-panel">
			<p class="bd-h"><b>Terraform and Pulumi</b><span>The lock draws the boundary</span></p>
			<svg viewBox="0 38 520 372" role="img" aria-label="Terraform and Pulumi: each tool's file holds identity, values and writes behind one lock, and that lock draws a boundary around a block of resources in the cloud account.">
				{FILES.map((f) => (
					<g>
						<rect class="bd-file" x={f.x} y="56" width="220" height="132" rx="10" />
						<text class="bd-mono" x={f.x + 14} y="78">{f.name}</text>
						{STRIPES.map(([t, k], i) => (
							<g>
								<rect class={`bd-stripe bd-${k}`} x={f.x + 12} y={88 + i * 31} width="196" height="25" rx="5" />
								<rect class={`bd-edge bd-${k}-f`} x={f.x + 12} y={88 + i * 31} width="4" height="25" rx="2" />
								<text class="bd-t" x={f.x + 26} y={105 + i * 31}>{t}</text>
							</g>
						))}
						<circle class="bd-lockbg" cx={f.x + 214} cy="58" r="15" />
						<path class="bd-lock" d={lock(f.x + 214, 60, 1.1)} />
						<line class="bd-tie" x1={f.cx} y1="188" x2={f.cx} y2="262" />
					</g>
				))}
				<rect class="bd-cloud" x="4" y="218" width="512" height="186" rx="14" />
				<text class="bd-cap" x="18" y="238">CLOUD ACCOUNT</text>
				<rect class="bd-wall" x="20" y="262" width="236" height="130" rx="12" />
				<rect class="bd-wall" x="262" y="262" width="240" height="130" rx="12" />
				{FILES.map((f) => (
					<g>
						<circle class="bd-lockbg" cx={f.cx} cy="262" r="12" />
						<path class="bd-lock" d={lock(f.cx, 264, 0.9)} />
					</g>
				))}
				{RES.map((r) => (
					<g>
						<rect class="bd-res" x={COLS[r.c]} y={ROWS[r.r]} width={PW} height={PH} rx="7" />
						<text class="bd-rt" x={COLS[r.c] + PW / 2} y={ROWS[r.r] + 20.5} text-anchor="middle">{r.n}</text>
					</g>
				))}
			</svg>
			<p class="bd-note">Each tool sews identity, values and writes into one file behind one lock. A state boundary is whatever that lock covers.</p>
		</div>

		<div class="bd-panel">
			<p class="bd-h"><b>choudoufu and plunge</b><span>The resources draw the boundary</span></p>
			<svg viewBox="0 38 520 372" role="img" aria-label="choudoufu and plunge: each resource in the cloud account carries its estate's label, and the labels draw three estates. Above, a record store holds one record per resource, each with its own small lock: the store's conditional write.">
				<rect class="bd-store" x="4" y="56" width="512" height="132" rx="12" />
				<text class="bd-cap" x="18" y="76">RECORD STORE · S3, GCS, AZURE BLOB, KUBERNETES</text>
				{RES.map((r) => (
					<g>
						<rect class="bd-rec" x={COLS[r.c]} y={r.r ? 140 : 94} width={PW} height="34" rx="6" />
						<text class="bd-rt" x={COLS[r.c] + 14} y={(r.r ? 140 : 94) + 21.5}>{r.n}</text>
						<path class="bd-lock bd-lock-sm" d={lock(COLS[r.c] + PW - 16, (r.r ? 140 : 94) + 17, 0.8)} />
					</g>
				))}
				<rect class="bd-cloud" x="4" y="218" width="512" height="186" rx="14" />
				<text class="bd-cap" x="18" y="238">CLOUD ACCOUNT</text>
				<path class="bd-estate bd-net" d="M22 262 H258 V328 H138 V392 H22 Z" />
				<rect class="bd-estate bd-data" x="144" y="336" width="114" height="56" rx="10" />
				<rect class="bd-estate bd-pay" x="262" y="262" width="240" height="130" rx="12" />
				{RES.map((r) => (
					<g>
						<rect class="bd-res" x={COLS[r.c]} y={ROWS[r.r]} width={PW} height={PH} rx="7" />
						<text class="bd-rt" x={COLS[r.c] + PW / 2 - 6} y={ROWS[r.r] + 20.5} text-anchor="middle">{r.n}</text>
						<circle class={`bd-dot bd-${r.e}-f`} cx={COLS[r.c] + PW - 13} cy={ROWS[r.r] + PH / 2} r="5" />
					</g>
				))}
				<g class="bd-label bd-net-f"><rect x="30" y="252" width="146" height="20" rx="10" /><text x="103" y="266" text-anchor="middle">tofu-estate = network</text></g>
				<g class="bd-label bd-pay-f"><rect x="272" y="252" width="200" height="20" rx="10" /><text x="372" y="266" text-anchor="middle">plunge-stack = payments/prod</text></g>
				<g class="bd-label bd-data-f"><rect x="141" y="382" width="120" height="20" rx="10" /><text x="201" y="396" text-anchor="middle">tofu-estate = data</text></g>
			</svg>
			<p class="bd-note">Each resource carries its estate's label, and the labels draw the estates. Every record has its own lock: the storage service's conditional write.</p>
		</div>
	</div>
	<figcaption id="bd-cap">Same account, same resources. With Terraform and Pulumi the lock sets the boundary; with choudoufu and plunge the resources do.</figcaption>
</figure>

<style>
	.bd {
		--id: #3fae8c; --val: #e2a23b; --wr: #d9637a;
		--net: #c9a96e; --data: #b98be0; --pay: #4a9fd0;
		margin: 2rem 0 2.5rem;
	}
	.bd-panels { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
	.bd-panel { padding: 1rem 1rem 1.1rem; border-radius: 16px; border: 1px solid var(--sl-color-gray-5); background: color-mix(in srgb, var(--sl-color-gray-6) 55%, transparent); }
	.bd-panel:last-child { border: 2px solid transparent; background: linear-gradient(var(--sl-color-black), var(--sl-color-black)) padding-box, linear-gradient(120deg, var(--net), var(--pay)) border-box; }
	.bd-h { display: flex; flex-direction: column; gap: 0.1rem; margin: 0 0 0.6rem; }
	.bd-h b { font-family: var(--in-display, inherit); font-size: 1.15rem; color: var(--sl-color-white); }
	.bd-h span { font-size: 0.85rem; color: var(--sl-color-gray-3); }
	.bd svg { display: block; width: 100%; height: auto; }
	.bd-note { margin: 0.6rem 0 0; font-size: 0.86rem; line-height: 1.45; color: var(--sl-color-gray-2); }
	.bd figcaption { margin-top: 0.9rem; font-size: 0.85rem; color: var(--sl-color-gray-3); }

	.bd text { font-family: var(--sl-font, system-ui, sans-serif); }
	.bd-mono, .bd-label text { font-family: var(--sl-font-mono, ui-monospace, monospace) !important; }
	.bd-mono { font-size: 12px; fill: var(--sl-color-gray-2); }
	.bd-t { font-size: 12px; font-weight: 600; fill: var(--sl-color-white); }
	.bd-cap { font-size: 10px; letter-spacing: 0.08em; fill: var(--sl-color-gray-3); }
	.bd-rt { font-size: 12px; fill: var(--sl-color-gray-1); }

	.bd-file { fill: var(--sl-color-black); stroke: var(--sl-color-gray-4); stroke-width: 2; }
	.bd-stripe { opacity: 0.18; }
	.bd-id, .bd-id-f { fill: var(--id); }
	.bd-val, .bd-val-f { fill: var(--val); }
	.bd-wr, .bd-wr-f { fill: var(--wr); }
	.bd-lockbg { fill: var(--sl-color-gray-5); stroke: var(--sl-color-black); stroke-width: 3; }
	.bd-lock { fill: var(--sl-color-black); stroke: var(--sl-color-black); stroke-width: 1.6; stroke-linejoin: round; }
	.bd-lock-sm { fill: var(--wr); stroke: var(--wr); stroke-width: 1.3; }
	.bd-tie { stroke: var(--sl-color-gray-4); stroke-width: 2; stroke-dasharray: 4 4; }

	.bd-cloud { fill: color-mix(in srgb, var(--sl-color-accent) 6%, transparent); stroke: var(--sl-color-gray-5); }
	.bd-store { fill: color-mix(in srgb, var(--val) 5%, transparent); stroke: var(--sl-color-gray-5); }
	.bd-wall { fill: color-mix(in srgb, var(--sl-color-gray-4) 12%, transparent); stroke: var(--sl-color-gray-4); stroke-width: 2.5; }
	.bd-res { fill: var(--sl-color-black); stroke: var(--sl-color-gray-5); }
	.bd-rec { fill: color-mix(in srgb, var(--val) 14%, transparent); stroke: color-mix(in srgb, var(--val) 50%, transparent); }

	.bd-estate { fill: none; stroke-width: 2; stroke-dasharray: 6 4; stroke-linejoin: round; }
	.bd-net { stroke: var(--net); fill: color-mix(in srgb, var(--net) 8%, transparent); }
	.bd-data { stroke: var(--data); fill: color-mix(in srgb, var(--data) 8%, transparent); }
	.bd-pay { stroke: var(--pay); fill: color-mix(in srgb, var(--pay) 8%, transparent); }
	.bd-net-f { fill: var(--net); } .bd-data-f { fill: var(--data); } .bd-pay-f { fill: var(--pay); }
	.bd-label text { font-size: 10px; font-weight: 600; fill: #14110b; }

	@media (max-width: 60rem) { .bd-panels { grid-template-columns: 1fr; } }
</style>
