---
// A vendor's logo in a column head: one file for the dark theme and one for
// the light, shown by theme. A pixel logo stays crisp; a wordmark logo that
// already carries the name is drawn wider and without the name under it. A
// vendor with no logo is its name, set as a wordmark.
const { v } = Astro.props;
const cls = v.named ? 'ar-pixel' : 'ar-wide';
---
{v.logo ? (
	<>
		<img class={`${cls} ar-on-dark`} src={v.logo.dark} alt={v.named ? '' : v.name} />
		<img class={`${cls} ar-on-light`} src={v.logo.light} alt={v.named ? '' : v.name} />
		{v.named && <span class="ar-logo-name">{v.name}</span>}
	</>
) : <span class="ar-wordmark">{v.name}</span>}
