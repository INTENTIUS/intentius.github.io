---
// The home page's parts. `part="top"` (the default) is the pixel eye, with
// the page's heading kept for screen readers only, then the picker
// (Picker.astro). `part="tools"` is the three open-source tools as
// tiles, under the "Open source" heading in index.mdx.
// One import keeps index.mdx's prose free of import lines.
import Picker from './Picker.astro';

interface Props {
	part?: 'top' | 'tools';
}
const { part = 'top' } = Astro.props;

const tools = [
	{ name: 'terragucci', href: 'https://intentius.io/terragucci/', body: 'One workflow for every Terraform repo, run in your own CI.' },
	{ name: 'choudoufu', href: 'https://intentius.io/choudoufu/', body: 'OpenTofu with a lock and an owner on every resource.' },
	{ name: 'chant', href: 'https://intentius.io/chant/', body: 'Infrastructure as typed code, checked before anything runs.' },
];
---
{part === 'top' && (
	<>
		<section class="in-landing not-content">
			<span class="in-logo hero-logo" aria-hidden="true"></span>
			<h1 class="sr-only">Intentius</h1>
		</section>
		<Picker />
	</>
)}
{part === 'tools' && (
	<ul class="in-tools not-content">
		{tools.map((t) => (
			<li>
				<a href={t.href}>
					<span class="in-mark" aria-hidden="true"></span>
					<b>{t.name}</b>
					<span>{t.body}</span>
				</a>
			</li>
		))}
	</ul>
)}

<style>
	.in-landing {
		display: grid;
		justify-items: center;
		padding-block: clamp(1.25rem, 3vw, 2rem) 0;
		text-align: center;
	}
	/* Three screen pixels per art pixel, so every square stays sharp. */
	.hero-logo {
		width: 171px;
		height: 96px;
	}
	.in-tools {
		list-style: none;
		max-width: 64rem;
		margin: 1rem auto 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.75rem;
	}
	.in-tools li {
		margin: 0;
		min-width: 0;
	}
	.in-tools a {
		display: grid;
		gap: 0.6rem;
		justify-items: start;
		height: 100%;
		padding: 1.1rem 1.15rem;
		font-size: var(--sl-text-sm);
		line-height: 1.45;
		color: var(--sl-color-gray-2);
		text-decoration: none;
		border: 1px solid var(--in-rule);
		border-top: 1px solid var(--in-gold);
		border-radius: 0.5rem;
		background: var(--in-panel);
		transition: border-color 0.15s;
	}
	.in-tools b {
		font-family: var(--in-display);
		font-size: var(--sl-text-base);
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.in-tools a:hover,
	.in-tools a:focus-visible {
		border-color: var(--in-gold);
	}
	@media (max-width: 50rem) {
		.in-tools {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.5rem;
		}
	}
</style>
