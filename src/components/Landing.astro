---
// The home page's parts. `part="top"` (the default) is the pixel eye, the
// wordmark, the mark between two gold hairlines, the tagline and two plain
// sentences, then the picker (Picker.astro). `part="tools"` is the three
// open-source tools as tiles, under the "Open source" heading in index.mdx.
// One import keeps index.mdx's prose free of import lines.
import Picker from './Picker.astro';

interface Props {
	part?: 'top' | 'tools';
}
const { part = 'top' } = Astro.props;

const tools = [
	{ name: 'terragucci', href: 'https://intentius.io/terragucci/', body: 'One workflow for every Terraform repo, run in your own CI.' },
	{ name: 'choudoufu', href: 'https://intentius.io/choudoufu/', body: 'OpenTofu with a lock and an owner on every resource.' },
	{ name: 'chant', href: 'https://intentius.io/chant/', body: 'Infrastructure as typed code, checked before anything runs.' },
];
---
{part === 'top' && (
	<>
		<section class="in-landing not-content">
			<span class="in-logo hero-logo" aria-hidden="true"></span>
			<h1 class="wordmark">INTENTIUS</h1>
			<span class="rule" aria-hidden="true"><span class="in-mark"></span></span>
			<p class="claim">Infrastructure consulting</p>
			<p class="lede">I build terragucci, choudoufu and chant, open-source tools for running infrastructure, and help teams put them to work. Everything runs in your CI, under your accounts, and stays yours.</p>
		</section>
		<Picker />
	</>
)}
{part === 'tools' && (
	<ul class="in-tools not-content">
		{tools.map((t) => (
			<li>
				<a href={t.href}>
					<span class="in-mark" aria-hidden="true"></span>
					<b>{t.name}</b>
					<span>{t.body}</span>
				</a>
			</li>
		))}
	</ul>
)}

<style>
	.in-landing {
		display: grid;
		justify-items: center;
		gap: 0.9rem;
		padding-block: clamp(1.5rem, 4vw, 2.5rem) 1.25rem;
		text-align: center;
	}
	/* Three screen pixels per art pixel, so every square stays sharp. */
	.hero-logo {
		width: 171px;
		height: 96px;
	}
	.wordmark {
		margin: 0.4rem 0 0;
		font-family: var(--in-display);
		font-weight: 500;
		font-size: clamp(1.4rem, 3.8vw, 1.8rem);
		letter-spacing: 0.4em;
		line-height: 1;
		color: var(--sl-color-white);
	}
	/* The mark between two gold hairlines, under the wordmark. */
	.rule {
		display: flex;
		align-items: center;
		gap: 0.9rem;
	}
	.rule::before,
	.rule::after {
		content: '';
		width: 2.6rem;
		height: 1px;
		background: var(--in-gold);
	}
	.claim {
		margin: 0;
		font-family: var(--in-display);
		font-size: 0.78rem;
		line-height: 1.3;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
	}
	.lede {
		margin: 0.4rem 0 0;
		max-width: 40rem;
		font-size: var(--sl-text-lg);
		line-height: 1.5;
		color: var(--sl-color-gray-1);
		text-wrap: pretty;
	}
	.in-tools {
		list-style: none;
		max-width: 64rem;
		margin: 1rem auto 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.75rem;
	}
	.in-tools li {
		margin: 0;
		min-width: 0;
	}
	.in-tools a {
		display: grid;
		gap: 0.6rem;
		justify-items: start;
		height: 100%;
		padding: 1.1rem 1.15rem;
		font-size: var(--sl-text-sm);
		line-height: 1.45;
		color: var(--sl-color-gray-2);
		text-decoration: none;
		border: 1px solid var(--in-rule);
		border-top: 1px solid var(--in-gold);
		border-radius: 0.5rem;
		background: var(--in-panel);
		transition: border-color 0.15s;
	}
	.in-tools b {
		font-family: var(--in-display);
		font-size: var(--sl-text-base);
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.in-tools a:hover,
	.in-tools a:focus-visible {
		border-color: var(--in-gold);
	}
	@media (max-width: 50rem) {
		.in-tools {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.5rem;
		}
	}
</style>
