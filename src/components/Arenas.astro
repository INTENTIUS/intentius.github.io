---
// A comparison as arenas, one per thing a reader decides on. `data` is a
// module like src/data/arenas.mjs (the default: terragucci against HCP
// Terraform and Spacelift): VENDORS, ARENAS, and optionally PLANS and GATED
// for a "what's included" arena, READ_ON, TRADEMARKS and TRY. The first
// vendor is ours. In each arena, hovering or focusing a vendor grows its logo, shrinks the others and
// lights its column; the logos themselves are never tinted or recoloured, as
// HashiCorp's and Spacelift's logo rules ask. GATED_BLURB words the gating
// arena's lead, and GRADIENT draws each heading's rule in the first three
// vendors' colours. Each cell links its source.
// The gating arena takes the features you tick and names the plan each
// vendor needs for all of them. Without script every arena still reads, with
// every feature ticked.
import * as terraformPlatforms from '../data/arenas.mjs';
import VendorLogo from './VendorLogo.astro';

const { data = terraformPlatforms } = Astro.props;
const { VENDORS, PLANS = {}, GATED = [], ARENAS, READ_ON, TRADEMARKS, LABEL, FEATURED = [], TRY } = data;
const GATED_BLURB = data.GATED_BLURB ?? "Tick what you need. These are terragucci's features; what it lacks is under The basics.";
const OURS = VENDORS[0].id;

// A row is a question, so its best answer is highlighted (ties allowed) and
// a vendor that doesn't do the thing at all gets a cross. Everything else is
// its words alone.
const GLYPH = { good: '', warn: '', bad: '✗' };
const WORD = { good: 'meets', warn: 'partly', bad: 'misses' };

// For the features ticked: the highest plan a vendor needs, and how many of
// them it has no equivalent for. A feature whose tier isn't published counts
// toward neither.
const need = (v, ids) => {
	let max = -1, none = 0;
	for (const f of GATED) {
		if (!ids.includes(f.id)) continue;
		const c = f[v];
		if (c.plan !== null) max = Math.max(max, c.plan);
		else if (c.tier !== 'unpublished') none++;
	}
	return { plan: max < 0 ? '-' : PLANS[v][max], none };
};
const all = GATED.map((f) => f.id);

// The best-answer key shows only where some cell is marked best.
const hasBest = GATED.length > 0 || ARENAS.some((a) => a.rows.some((r) => VENDORS.some((v) => r[v.id][0] === 'good')));
const lead = (a, v) => (v.id === OURS && a.lead ? a.lead.name : v.name);
const host = (u) => (u.startsWith('/') ? 'intentius.io' : new URL(u).hostname.replace(/^www\./, ''));
---
<section class="arenas not-content" aria-label={LABEL ?? `${VENDORS.map((v) => v.name).join(', ')} compared`} style={[`--n:${VENDORS.length}`, ...VENDORS.map((v) => `--c-${v.id}:${v.color ?? 'var(--muted)'}`), ...(data.GRADIENT ? [`--ar-grad:${VENDORS.slice(0, 3).map((v) => `var(--c-${v.id})`).join(', ')}`] : [])].join(';')}>

	<p class="ar-key">{VENDORS.map((v) => <span><i style={`background:var(--c-${v.id})`}></i><b>{v.name}</b>{v.what && <em>{v.what}</em>}</span>)}</p>
	{TRY && <p class="ar-try">{TRY.map(([text, href]) => <a href={href}>{text} →</a>)}</p>}

	<p class="ar-legend">
		{hasBest && <span><b class="ar-best-key"></b> the best answer in the row</span>}
		<span><b class="ar-mark bad">✗</b> doesn't do it</span>
		{READ_ON && <span class="ar-hint">Sources read {READ_ON}.</span>}
	</p>

	{ARENAS.filter((a) => a.first).map((a) => (
		<div class="ar-arena" id={`ar-${a.id}`} data-arena>
			<header><h2>{a.title}</h2>{a.blurb && <p>{a.blurb}</p>}</header>
			<div class="ar-grid">
				<div class="ar-row ar-head">
					<span></span>
					{VENDORS.map((x) => {
						const v = x.id === OURS && a.lead ? { ...x, ...a.lead } : x;
						return v.link
							? <a class="ar-vendor" data-v={x.id} href={v.href} style={`--vc:var(--c-${x.id})`}><VendorLogo v={v} /></a>
							: <button type="button" class="ar-vendor" data-v={x.id} aria-label={`Follow ${v.name}`} style={`--vc:var(--c-${x.id})`}><VendorLogo v={v} /></button>;
					})}
				</div>
				{a.rows.map((r) => (
					<div class="ar-row">
						<span class="ar-q">{r.q}{r.note && <a class="ar-note" href={r.href}>{r.note}</a>}</span>
						{VENDORS.map((v) => {
							const [m, text, src] = r[v.id];
							return (
								<span class={`ar-cell${m === 'good' ? ' ar-best' : ''}`} data-v={v.id} style={`--vc:var(--c-${v.id})`} title={m === 'good' ? `${lead(a, v)}: the best answer in this row` : undefined}>
									<span>{GLYPH[m] && <><b class={`ar-mark ${m}`} aria-label={WORD[m]}>{GLYPH[m]}</b> </>}{text}</span>
									{src && <a class="ar-src" href={src}>{host(src)}</a>}
								</span>
							);
						})}
					</div>
				))}
			</div>
		</div>
	))}

	{GATED.length > 0 && <div class="ar-arena" id="ar-gating" data-arena>
		<header><h2>What's included</h2><p>{GATED_BLURB}</p></header>
		<div class="ar-grid">
			<div class="ar-row ar-head">
				<span></span>
				{VENDORS.map((v) => (
					v.link
						? <a class="ar-vendor" data-v={v.id} href={v.href} style={`--vc:var(--c-${v.id})`}><VendorLogo v={v} /></a>
						: <button type="button" class="ar-vendor" data-v={v.id} aria-label={`Follow ${v.name}`} style={`--vc:var(--c-${v.id})`}><VendorLogo v={v} /></button>
				))}
			</div>
			{GATED.map((f) => (
				<label class={`ar-row ar-gate${FEATURED.length && !FEATURED.includes(f.id) ? ' ar-more' : ''}`}>
					<span class="ar-q"><input type="checkbox" value={f.id} checked /> {f.label}</span>
					{VENDORS.map((v) => {
						const c = f[v.id];
						return (
							<span class="ar-cell" data-v={v.id} style={`--vc:var(--c-${v.id})`}>
								{c.plan !== null
									? <b>{PLANS[v.id][c.plan]}</b>
									: c.tier === 'unpublished' ? <b class="ar-unpub">Tier not published</b> : <b class="ar-none"><span class="ar-mark bad">✗</span> None</b>}
								{c.note && <small>{c.note.replace(/^(tier not published|none documented)(; )?/, '')}</small>}
								<a class="ar-src" href={c.src}>{host(c.src)}</a>
							</span>
						);
					})}
				</label>
			))}
			{FEATURED.length > 0 && (
				<button type="button" class="ar-showall" data-showall>Show all {GATED.length} features</button>
			)}
			<div class="ar-row ar-total">
				<span class="ar-q">The plan you'd need</span>
				{VENDORS.map((v) => {
					const n = need(v.id, all);
					return <span class={`ar-cell${v.id === OURS ? ' ar-ours' : ''}`} data-v={v.id} data-need={v.id}><b>{n.plan}</b><small class="ar-lacks">{n.none ? `and still lacks ${n.none}` : ''}</small></span>;
				})}
			</div>
		</div>
	</div>}

	{ARENAS.filter((a) => !a.first).map((a) => (
		<div class="ar-arena" id={`ar-${a.id}`} data-arena>
			<header><h2>{a.title}</h2>{a.blurb && <p>{a.blurb}</p>}</header>
			<div class="ar-grid">
				<div class="ar-row ar-head">
					<span></span>
					{VENDORS.map((x) => {
						const v = x.id === OURS && a.lead ? { ...x, ...a.lead } : x;
						return v.link
							? <a class="ar-vendor" data-v={x.id} href={v.href} style={`--vc:var(--c-${x.id})`}><VendorLogo v={v} /></a>
							: <button type="button" class="ar-vendor" data-v={x.id} aria-label={`Follow ${v.name}`} style={`--vc:var(--c-${x.id})`}><VendorLogo v={v} /></button>;
					})}
				</div>
				{a.rows.map((r) => (
					<div class="ar-row">
						<span class="ar-q">{r.q}{r.note && <a class="ar-note" href={r.href}>{r.note}</a>}</span>
						{VENDORS.map((v) => {
							const [m, text, src] = r[v.id];
							return (
								<span class={`ar-cell${m === 'good' ? ' ar-best' : ''}`} data-v={v.id} style={`--vc:var(--c-${v.id})`} title={m === 'good' ? `${lead(a, v)}: the best answer in this row` : undefined}>
									<span>{GLYPH[m] && <><b class={`ar-mark ${m}`} aria-label={WORD[m]}>{GLYPH[m]}</b> </>}{text}</span>
									{src && <a class="ar-src" href={src}>{host(src)}</a>}
								</span>
							);
						})}
					</div>
				))}
			</div>
		</div>
	))}

	{TRADEMARKS && <p class="ar-tm">{TRADEMARKS}</p>}
</section>

<script is:inline define:vars={{ PLANS, GATED, VENDORS }}>
	// Follow a vendor: hover, focus or tap its logo. A tap on the followed one lets go.
	document.querySelectorAll('[data-arena]').forEach(function (arena) {
		var set = function (v) {
			if (v) arena.dataset.focus = v; else delete arena.dataset.focus;
			arena.querySelectorAll('.ar-vendor, .ar-cell').forEach(function (el) { el.classList.toggle('ar-lit', !!v && el.dataset.v === v); });
		};
		arena.querySelectorAll('.ar-vendor').forEach(function (b) {
			b.addEventListener('mouseenter', function () { set(b.dataset.v); });
			b.addEventListener('focus', function () { set(b.dataset.v); });
			// Our own products' logos are links to their sites; a click on one goes there.
			if (b.tagName === 'A') return;
			b.addEventListener('click', function () { set(arena.dataset.focus === b.dataset.v && arena.dataset.pinned ? '' : b.dataset.v); arena.dataset.pinned = arena.dataset.focus ? '1' : ''; });
		});
		arena.addEventListener('mouseleave', function () { if (!arena.dataset.pinned) set(''); });
	});
	// The gating arena: the plan each vendor needs for every ticked feature.
	var gate = document.getElementById('ar-gating');
	var more = gate && gate.querySelector('[data-showall]');
	if (more) more.addEventListener('click', function () {
		var open = gate.classList.toggle('ar-all');
		more.textContent = open ? 'Show the main features' : 'Show all ' + gate.querySelectorAll('.ar-gate').length + ' features';
	});
	if (gate) {
		var boxes = gate.querySelectorAll('input[type=checkbox]');
		var update = function () {
			var ids = Array.prototype.filter.call(boxes, function (b) { return b.checked; }).map(function (b) { return b.value; });
			VENDORS.forEach(function (v) {
				var max = -1, none = 0;
				GATED.forEach(function (f) {
					if (ids.indexOf(f.id) < 0) return;
					var c = f[v.id];
					if (c.plan !== null) max = Math.max(max, c.plan);
					else if (c.tier !== 'unpublished') none++;
				});
				var cell = gate.querySelector('[data-need="' + v.id + '"]');
				cell.querySelector('b').textContent = max < 0 ? '-' : PLANS[v.id][max];
				cell.querySelector('.ar-lacks').textContent = none ? 'and still lacks ' + none : '';
			});
			boxes.forEach(function (b) { b.closest('.ar-gate').classList.toggle('ar-off', !b.checked); });
		};
		boxes.forEach(function (b) { b.addEventListener('change', update); });
		update();
	}
</script>

<style is:global>
.arenas {
	--ink: var(--sl-color-white); --muted: var(--sl-color-gray-2); --faint: var(--sl-color-gray-3);
	--rule: var(--in-rule); --panel: var(--in-panel); --lit: color-mix(in srgb, var(--in-accent) 12%, transparent);
	--good: #57d6a0; --warn: #e2b558; --bad: #f27676;
	--cols: minmax(8rem, 1.1fr) repeat(var(--n, 3), minmax(0, 1fr));
	font-size: 0.95rem; line-height: 1.45; margin-top: 1rem;
}
:root[data-theme='light'] .arenas { --good: #11805a; --warn: #8f6200; --bad: #c23434; }
.arenas a { text-decoration: none; color: var(--in-accent); }

.ar-legend { display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; font-size: 0.82rem; color: var(--muted); margin: 0 0 1.4rem; }
.ar-hint { color: var(--faint); font-style: italic; }
.ar-mark { font-weight: 700; }
.ar-best-key { display: inline-block; width: 0.9rem; height: 0.9rem; vertical-align: -0.1rem; border-left: 3px solid var(--good); background: color-mix(in srgb, var(--good) 14%, transparent); border-radius: 2px; }
.ar-cell.ar-best { box-shadow: inset 3px 0 0 var(--good); background: color-mix(in srgb, var(--good) 8%, transparent); }
.ar-mark.good { color: var(--good); } .ar-mark.warn { color: var(--warn); } .ar-mark.bad { color: var(--bad); }

.ar-key { display: flex; flex-wrap: wrap; gap: 0.3rem 1.4rem; margin: 0 0 0.5rem; font-size: 0.85rem; color: var(--muted); }
.ar-key span { display: inline-flex; align-items: center; gap: 0.4rem; }
.ar-key i { display: inline-block; width: 0.55rem; height: 0.55rem; border-radius: 50%; flex: none; }
.ar-key b { color: var(--ink); font-weight: 600; }
.ar-key em { font-style: normal; color: var(--muted); }
.ar-try { display: flex; flex-wrap: wrap; gap: 0.3rem 1.3rem; margin: 0 0 1.2rem; font-size: 0.88rem; font-weight: 600; }
.ar-gate.ar-more { display: none; }
.ar-all .ar-gate.ar-more { display: grid; }
.ar-showall {
	display: block; width: 100%; padding: 0.55rem; border: 0; border-top: 1px solid var(--rule);
	background: none; color: var(--in-accent); font: inherit; font-size: 0.85rem; cursor: pointer;
}

/* ---- an arena ---- */
.ar-arena { margin: 0 0 2.4rem; scroll-margin-top: 5rem; }
.arenas .ar-arena header h2 { font-size: 1.25rem; margin: 0 0 0.2rem; padding-left: 0.6rem; border-left: 4px solid !important; border-image: linear-gradient(var(--ar-grad, var(--c-tg, var(--in-accent)), var(--c-hcp, var(--in-accent)), var(--c-sl, var(--in-accent)))) 1 !important; }
.ar-arena header p { margin: 0 0 0.8rem; color: var(--muted); font-size: 0.9rem; }
.ar-grid { border: 1px solid var(--rule); border-radius: 10px; overflow: hidden; }
.ar-row { display: grid; grid-template-columns: var(--cols); align-items: stretch; border-top: 1px solid var(--rule); }
.ar-row > * { padding: 0.6rem 0.7rem; }
.ar-head { border-top: none; align-items: center; background: var(--panel); position: sticky; top: 0; z-index: 1; }
.ar-head .ar-vendor { box-shadow: inset 0 -3px 0 var(--vc, transparent); }
.ar-q { font-weight: 600; color: var(--ink); }
.ar-note { display: block; margin-top: 0.2rem; font-weight: 400; font-size: 0.78rem; line-height: 1.35; color: var(--muted) !important; }
.ar-cell { color: var(--ink); transition: background-color .2s ease; }
.ar-cell small { display: block; color: var(--muted); font-size: 0.78rem; }
.ar-src { display: block; font-size: 0.7rem; margin-top: 0.15rem; opacity: 0.8; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ar-cell { min-width: 0; overflow-wrap: anywhere; }

/* The logo for each vendor: it grows when followed, the others shrink. */
.ar-vendor {
	display: flex; align-items: center; justify-content: center; height: 4rem; padding: 0.4rem;
	background: none; border: 0; cursor: pointer; color: var(--ink) !important; text-decoration: none;
	transition: transform .28s cubic-bezier(.2,.8,.2,1.2);
}
.ar-vendor { flex-direction: column; gap: 0.25rem; height: 4.6rem; }
.ar-vendor img { height: 2rem; width: auto; max-width: 100%; object-fit: contain; }
.ar-vendor img.ar-pixel { image-rendering: pixelated; }
.ar-vendor img.ar-wide { height: 1.7rem; }
.ar-vendor img.ar-wide.ar-half { height: 1.45rem; }
.ar-logo-name { font: 700 0.8rem/1 var(--in-display); }
/* One logo file per theme: the dark one by default, the light one under data-theme='light'. */
.ar-vendor .ar-on-light { display: none; }
:root[data-theme='light'] .ar-vendor .ar-on-light { display: block; }
:root[data-theme='light'] .ar-vendor .ar-on-dark { display: none; }
.ar-tm { font-size: 0.7rem; color: var(--faint); margin: 1rem 0 0; }
.ar-wordmark { font: 700 1.05rem/1.1 var(--in-display); letter-spacing: -0.01em; text-align: center; }
.ar-vendor:focus-visible { outline: 2px solid var(--in-accent); outline-offset: -4px; border-radius: 8px; }
[data-focus] .ar-vendor { transform: scale(0.86); }
[data-focus] .ar-vendor.ar-lit { transform: scale(1.22); }
.ar-cell.ar-lit { background: color-mix(in srgb, var(--vc, var(--in-accent)) 16%, transparent); }
.ar-cell.ar-best.ar-lit { background: color-mix(in srgb, var(--vc, var(--in-accent)) 16%, transparent); }

/* The gating arena. */
.ar-gate { cursor: pointer; }
.ar-gate input { accent-color: var(--in-accent); margin-right: 0.35rem; }
.ar-gate.ar-off .ar-cell { opacity: 0.35; }
.ar-total { background: var(--panel); }
.ar-total .ar-cell b { font-size: 1.05rem; }
.ar-total .ar-ours b { color: var(--good); }
.ar-lacks { color: var(--bad) !important; }
.ar-unpub { color: var(--muted); font-weight: 600; }
.ar-none { color: var(--muted); }

@media (prefers-reduced-motion: reduce) {
	.ar-vendor, .ar-card, .ar-cell { transition: none; }
	[data-focus] .ar-vendor { transform: none; }
	[data-focus] .ar-vendor.ar-lit { transform: none; }
}
@media (max-width: 40rem) {
	.arenas { --cols: minmax(5.5rem, 1fr) repeat(var(--n, 3), minmax(0, 1fr)); font-size: 0.8rem; }
	.ar-row > * { padding: 0.45rem 0.4rem; }
	.ar-wordmark { font-size: 0.8rem; }
	.ar-vendor img { height: 1.4rem; }
	.ar-vendor img.ar-wide { height: 1.05rem; }
	.ar-total .ar-cell b { font-size: 0.85rem; }
	.ar-src { font-size: 0.62rem; }
}
</style>
