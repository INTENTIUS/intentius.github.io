---
// A short preview of the terragucci, HCP Terraform and Spacelift comparison
// for a page that should send readers there: four rows read from
// data/arenas.mjs, so the preview never disagrees with the page it links.
import { VENDORS, PLANS, GATED, ARENAS } from '../data/arenas.mjs';

const row = (arena, q) => ARENAS.find((a) => a.id === arena).rows.find((r) => r.q === q);
const need = (v) => {
	let max = -1, none = 0;
	for (const f of GATED) {
		const c = f[v];
		if (c.plan !== null) max = Math.max(max, c.plan);
		else if (c.tier !== 'unpublished') none++;
	}
	return PLANS[v][max] + (none ? `, still missing ${none} features` : '');
};
const rows = [
	{ q: 'The plan you need for all of it', cells: Object.fromEntries(VENDORS.map((v) => [v.id, ['', need(v.id)]])) },
	{ q: 'How you pay', cells: row('basics', 'No licence or usage fees') },
	{ q: 'Your pipeline, if you leave', cells: row('leaving', 'Your pipeline leaves with you') },
	{ q: 'What one apply locks', cells: row('concurrency', 'One apply locks less than a whole root') },
];
const ours = VENDORS[0].id;
---
<a class="in-teaser not-content" href="/compare/terraform-platforms/">
	<span class="t-head">
		<b>Before you move, see how they compare</b>
		<span class="t-key">{VENDORS.map((v) => <span><i style={`background:${v.color}`}></i>{v.name}</span>)}</span>
	</span>
	{rows.map((r) => (
		<span class="t-row">
			<span class="t-q">{r.q}</span>
			{VENDORS.map((v) => <span class={`t-a${v.id === ours ? ' t-ours' : ''}`}><i style={`background:${v.color}`}></i>{v.id !== ours && r.cells[v.id][0] ? (r.cells[v.id][0] === 'bad' ? '✗ ' : '✓ ') : ''}{r.cells[v.id][1]}</span>)}
		</span>
	))}
	<span class="t-go">See the full comparison →</span>
</a>

<style>
	.in-teaser {
		display: grid; gap: 0.1rem; padding: 1rem 1.15rem; text-decoration: none; color: var(--sl-color-white);
		border: 1px solid var(--in-rule); border-top: 2px solid var(--in-accent); border-radius: 0.6rem; background: var(--in-panel);
		transition: border-color .2s ease, transform .2s ease;
	}
	.in-teaser:hover, .in-teaser:focus-visible { border-color: var(--in-accent); transform: translateY(-2px); }
	.t-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.4rem 1rem; margin-bottom: 0.5rem; }
	.t-head b { font-size: var(--sl-text-base); }
	.t-key { display: flex; gap: 1rem; font-size: 0.78rem; color: var(--sl-color-gray-2); }
	.t-key span, .t-a { display: inline-flex; align-items: baseline; gap: 0.4rem; }
	i { display: inline-block; width: 0.5rem; height: 0.5rem; border-radius: 50%; flex: none; }
	.t-row { display: grid; grid-template-columns: minmax(9rem, 1.1fr) repeat(3, minmax(0, 1fr)); gap: 0.8rem; padding: 0.45rem 0; border-top: 1px solid var(--in-rule); font-size: 0.82rem; line-height: 1.35; color: var(--sl-color-gray-2); }
	.t-q { font-weight: 600; color: var(--sl-color-white); }
	.t-ours { color: var(--sl-color-white); font-weight: 600; }
	.t-go { margin-top: 0.6rem; font-weight: 600; color: var(--in-accent); }
	@media (max-width: 40rem) {
		.t-row { grid-template-columns: 1fr; gap: 0.15rem; }
	}
	@media (prefers-reduced-motion: reduce) { .in-teaser { transition: none; } }
</style>
